/* D10 / P1.14 drives the AO3400A low-side backlight MOSFET. */
&pinctrl {
    wlf_pwm0_default: wlf_pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 14)>;
        };
    };

    wlf_pwm0_sleep: wlf_pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 14)>;
            low-power-enable;
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&wlf_pwm0_default>;
    pinctrl-1 = <&wlf_pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };
};

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

&mmv {
    trigger-period-ms = <16>;
    delay-ms = <0>;
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        bat_cb {
            timeout-ms = <50>;
            key-positions = <35 36>; // Left thumb: mo 1 + Space
            bindings = <&ind_bat>;
            slow-release;
            layers = <0>;
        };

        conn_cb {
            bindings = <&ind_con>;
            key-positions = <37 38>;
            layers = <0>;
            slow-release;
        };

        tab_cb {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
            layers = <0>;
            slow-release;
        };

        home_cb {
            bindings = <&kp HOME>;
            key-positions = <18 19>;
            layers = <0>;
            slow-release;
        };

        end_cb {
            bindings = <&kp END>;
            key-positions = <20 21>;
            layers = <0>;
            slow-release;
        };

        bksp_cb {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
            layers = <0>;
            slow-release;
        };

        ctrl_w_cb {
            bindings = <&kp LC(W)>;
            key-positions = <2 3>;
            layers = <0>;
            slow-release;
        };

        ctrl_a_cb {
            bindings = <&kp LC(A)>;
            key-positions = <14 15>;
            slow-release;
            layers = <0>;
        };

        enter_cb {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            layers = <0>;
            slow-release;
        };

        pgup_cb {
            bindings = <&kp PAGE_UP>;
            key-positions = <7 6>;
            layers = <0>;
            slow-release;
        };

        pgdn_cb {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <29 30>;
            layers = <0>;
            slow-release;
        };
    };

    macros {
        type_email: type_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp I &kp L &kp L &kp I &kp A &kp M &kp A &kp M &kp A &kp R &kp A &kp L &kp N5 &kp N2 &kp N1 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "TYPE_EMAIL";
        };

        type_wrk_email: type_wrk_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp I &kp L &kp L &kp I &kp A &kp M &kp DOT &kp C &kp O &kp S &kp T &kp A &kp AT &kp Z &kp U &kp P &kp DOT &kp C &kp O &kp M &kp DOT &kp B &kp R>;
            label = "TYPE_WRK_EMAIL";
        };
    };

    behaviors {
        td_media: td_media {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MEDIA";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 0>;
        };

        td_light: td_light {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LIGHT";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 4>;
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <245>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 29 30 31 32 33 37 38 39>;
            hold-trigger-on-release;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <245>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 34 35 36>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
&kp LEFT_CONTROL       &kp Q  &kp W                 &kp E                     &kp R                   &kp T      &kp Y      &kp U                    &kp I                      &kp O                  &kp P     &kp BSPC
&mt LEFT_SHIFT ESCAPE  &kp A  &hrm_left LEFT_ALT S  &hrm_left LEFT_CONTROL D  &hrm_left LEFT_SHIFT F  &kp G      &kp H      &hrm_right LEFT_SHIFT J  &hrm_right LEFT_CONTROL K  &hrm_right LEFT_ALT L  &kp SEMI  &mt LEFT_CONTROL ESCAPE
                       &kp Z  &kp X                 &kp C                     &kp V                   &kp B      &kp N      &kp M                    &kp COMMA                  &kp DOT                &kp FSLH
                                                    &kp LGUI                  &mo 1               &kp SPACE  &kp ENTER  &mo 2                &kp RALT
            >;
        };

        symbol {
            display-name = "sym";
            bindings = <
&kp DELETE  &kp EXCL  &kp AT        &kp HASH       &kp DLLR          &kp PRCNT          &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR           &kp RPAR  &trans
&trans      &trans    &kp SLASH     &kp BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS  &kp EQUAL  &kp GRAVE  &kp SINGLE_QUOTE   &trans    &trans
            &trans    &kp QUESTION  &kp PIPE       &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp UNDER  &kp PLUS   &kp TILDE  &kp DOUBLE_QUOTES  &trans
                                    &trans         &none             &trans             &trans     &mo 3      &trans
            >;
        };

        number {
            display-name = "num";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5   &kp NUMBER_6  &kp N7    &kp N8  &kp N9     &kp NUMBER_0  &trans
&trans  &kp F2        &kp F5        &trans        &kp F11       &kp F12  &kp LEFT      &kp DOWN  &kp UP  &kp RIGHT  &trans        &trans
        &trans        &trans        &trans        &trans        &trans   &trans        &trans    &trans  &trans     &trans
                                    &trans        &mo 4         &trans   &trans        &none     &trans
            >;
        };

        device {
            display-name = "dev";
            bindings = <
&bt BT_CLR    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &mkp MB4        &mkp LCLK       &mkp MCLK     &mkp RCLK        &trans  &type_email
&out OUT_TOG  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2    &bt BT_SEL 3      &bt BT_SEL 4     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &type_wrk_email
              &trans                &trans                &kp K_MUTE      &kp C_VOL_DN      &kp C_VOLUME_UP  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                                          &trans          &none             &trans           &trans          &none           &trans
            >;
        };

        light {
            display-name = "lght";
            bindings = <
&trans  &trans  &trans           &trans           &trans           &trans           &trans      &trans      &trans  &trans  &trans  &trans
&trans  &trans  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &rgb_ug RGB_SAI  &rgb_ug RGB_ON   &bl BL_ON   &bl BL_INC  &trans  &trans  &trans  &trans
        &trans  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR  &rgb_ug RGB_SAD  &rgb_ug RGB_OFF  &bl BL_OFF  &bl BL_DEC  &trans  &trans  &trans
                                 &trans           &trans           &trans           &trans      &none       &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
